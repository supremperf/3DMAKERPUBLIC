{
  "name": "3dmaker",
  "version": "1.0.0",
  "private": true,
  "description": "Studio de modélisation 3D et création assistée par IA",
  "author": "3DMAKER",
  "license": "MIT",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:web": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.test.json",
    "build": "npm run typecheck && vite build && node scripts/build-electron.mjs",
    "dist": "npm run build && electron-builder --win nsis --x64",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview --host 0.0.0.0",
    "postinstall": "node node_modules/electron/install.js",
    "test:browser": "node tests/browser/smoke.mjs",
    "test:browser:simple": "node tests/browser/simple.mjs",
    "test:browser:providers": "node tests/browser/providers.mjs",
    "package:sources": "node scripts/package-sources.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "fflate": "^0.8.3",
    "lucide-react": "^1.55.0",
    "meshoptimizer": "^1.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1",
    "three-bvh-csg": "^0.0.18",
    "three-mesh-bvh": "^0.9.16",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.27.4",
    "playwright": "^1.64.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
